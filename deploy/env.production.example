# Production environment — copy to server and adjust secrets.
# Frontend: frontend/.env.production.local (or export before `npm run build`)
# Backend:  backend/.env

# ── Public site (required for SEO, GEO, sitemap, links) ──
NEXT_PUBLIC_SITE_URL=https://leapai.ai
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_URL=/backend

# ── Frontend server (Next.js SSR / rewrites) ──
API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000
NODE_ENV=production

# ── Backend API ──
PORT=4000
MONGODB_URI=mongodb://leap:CHANGE_ME@localhost:27017/leapai?authSource=admin
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME-long-random-secret
CORS_ORIGIN=https://leapai.ai,https://leapai-webhook.bab.solutions
ADMIN_EMAIL=admin@leapai.ai
ADMIN_PASSWORD=CHANGE_ME
ENFORCE_PROD_SECRETS=true

# Book-a-demo leads (hero form) — sent to Sales
DEMO_LEADS_EMAIL=sales@leapai.ai
CONTACT_EMAIL=info@leapai.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@leapai.ai
SMTP_PASS=CHANGE_ME
SMTP_FROM=LeapAI Website <noreply@leapai.ai>
# Microsoft 365 alternative: SMTP_HOST=smtp.office365.com

# ── Deploy steps ──
# 1. Copy this file values into frontend/.env.production.local and backend/.env
# 2. cd frontend && VALIDATE_PROD_ENV=true npm run build
# 3. pm2 start ecosystem.config.cjs --env production
# 4. Apply deploy/nginx-root-hosting.conf and reload nginx
# 5. Verify: https://leapai.ai/llms.txt
