# Production environment — copy to server and adjust secrets.
# Frontend: frontend/.env.production.local (or export before `npm run build`)
# Backend:  backend/.env

# ── Public site (required for SEO, GEO, sitemap, links) ──
NEXT_PUBLIC_SITE_URL=https://leapai.ai
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_URL=/backend

# ── Frontend server (Next.js SSR / rewrites) ──
API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000
NODE_ENV=production

# ── Backend API ──
PORT=4000
MONGODB_URI=mongodb://leap:CHANGE_ME@localhost:27017/leapai?authSource=admin
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME-long-random-secret-at-least-32-chars
MFA_CODE_SECRET=CHANGE_ME-independent-mfa-secret-32-chars
CORS_ORIGIN=https://leapai.ai,https://leapai-webhook.bab.solutions
ADMIN_EMAIL=admin@leapai.ai
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ENFORCE_PROD_SECRETS=true
# Optional: header-only IndexNow deploy auth (never put this in a URL query string)
# INDEXNOW_SUBMIT_SECRET=CHANGE_ME_INDEXNOW_SECRET

# Mongo must not use leapsecret on a public host; prefer private network / 127.0.0.1 bind only.
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_PASSWORD

# All form notifications (demo, contact, partner, campaign, careers)
NOTIFICATION_EMAIL=info@leapai.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@leapai.ai
SMTP_PASS=CHANGE_ME
SMTP_FROM="LeapAI Website <info@leapai.ai>"
# Microsoft 365 alternative: SMTP_HOST=smtp.office365.com

# ── Deploy steps ──
# 1. Copy this file values into frontend/.env.production.local and backend/.env (or root .env for Docker)
# 2. Set NOTIFICATION_EMAIL and SMTP_PASS, then restart backend (docker compose up -d --force-recreate backend)
# 3. cd frontend && VALIDATE_PROD_ENV=true npm run build
# 4. pm2 start ecosystem.config.cjs --env production
# 5. Apply deploy/nginx-root-hosting.conf and reload nginx
# 6. Verify: https://leapai.ai/llms.txt
