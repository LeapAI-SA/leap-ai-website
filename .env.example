# Copy to .env in project root for Docker Compose
# Local defaults below are for development only — never use them in production.
JWT_SECRET=dev-jwt-secret-change-in-production
ADMIN_EMAIL=admin@leapai.ai
ADMIN_PASSWORD=admin123
ENFORCE_PROD_SECRETS=false
# Mongo (compose binds 127.0.0.1:27017 only). Change MONGO_ROOT_PASSWORD in production.
MONGO_ROOT_PASSWORD=leapsecret

# Public site URL (required for GEO/SEO — baked into llms.txt, robots.txt, sitemap)
NEXT_PUBLIC_SITE_URL=https://leapai.ai
NEXT_PUBLIC_BASE_PATH=
CORS_ORIGIN=https://leapai.ai,https://leapai-webhook.bab.solutions,http://localhost:3000

# Frontend (local) — use /backend so the httpOnly auth cookie is same-origin
NEXT_PUBLIC_API_URL=/backend

# Backend (local dev) — see backend/.env.example
MONGODB_URI=mongodb://leap:leapsecret@localhost:27017/leapai?authSource=admin
REDIS_URL=redis://localhost:6379

# All form notifications (demo, contact, partner, campaign, careers) — set SMTP_PASS in root .env
NOTIFICATION_EMAIL=noreply@leapai.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@leapai.ai
SMTP_PASS=
SMTP_FROM="LeapAI Website <noreply@leapai.ai>"
# Microsoft 365 alternative: SMTP_HOST=smtp.office365.com
