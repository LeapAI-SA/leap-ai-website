# Local development (copy to backend/.env)
PORT=4000
MONGODB_URI=mongodb://leap:leapsecret@localhost:27017/leapai?authSource=admin
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-change-in-production
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@leapai.ai
ADMIN_PASSWORD=admin123
ENFORCE_PROD_SECRETS=false

# All form notifications (demo, contact, partner, campaign, careers)
NOTIFICATION_EMAIL=noreply@leapai.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@leapai.ai
SMTP_PASS=
SMTP_FROM="LeapAI Website <noreply@leapai.ai>"
# Microsoft 365 alternative: SMTP_HOST=smtp.office365.com

# Production — see deploy/env.production.example
# CORS_ORIGIN=https://leapai.ai,https://leapai-webhook.bab.solutions
# ENFORCE_PROD_SECRETS=true
# JWT_SECRET= (min 32 chars, not a known default)
# ADMIN_PASSWORD= (not admin123)
