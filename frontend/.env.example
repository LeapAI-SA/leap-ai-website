# Local development (copy to frontend/.env)
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000
# Google Tag Manager (leave empty to disable locally; defaults to GTM-KTRBN5S2)
NEXT_PUBLIC_GTM_ID=GTM-KTRBN5S2
# Google Analytics 4 (leave empty to disable locally; defaults to G-BCLTJXVS8F)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BCLTJXVS8F

# Production (copy to frontend/.env.production.local before npm run build)
# NEXT_PUBLIC_API_URL=/backend
# NEXT_PUBLIC_SITE_URL=https://leapai.ai
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_GTM_ID=GTM-KTRBN5S2
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BCLTJXVS8F
# API_URL=http://localhost:4000
# INTERNAL_API_URL=http://localhost:4000
