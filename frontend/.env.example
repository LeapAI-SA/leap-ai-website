# Local development (copy to frontend/.env)
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000
# Google Tag Manager (leave empty to disable locally; defaults to GTM-NC7WPDNV)
NEXT_PUBLIC_GTM_ID=GTM-NC7WPDNV
# Google Analytics 4 (leave empty to disable locally; defaults to G-7NWB9C7RNB)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7NWB9C7RNB

# Production (copy to frontend/.env.production.local before npm run build)
# NEXT_PUBLIC_API_URL=/backend
# NEXT_PUBLIC_SITE_URL=https://leapai.ai
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_GTM_ID=GTM-NC7WPDNV
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7NWB9C7RNB
# API_URL=http://localhost:4000
# INTERNAL_API_URL=http://localhost:4000
